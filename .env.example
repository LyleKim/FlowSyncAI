# Copy to .env. No real secrets here; in AWS, fill the (secret) ones from SSM Parameter Store / Secrets Manager.

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# GROQ_API_KEY: Required for Groq AI checklist/description generation. (secret)
GROQ_API_KEY=""
# GROQ_MODEL: optional override of the default Groq model.
# GROQ_MODEL=""

# GITHUB_TOKEN: fine-grained or classic token with repo read access. (secret)
# Needed for the review-requested PR search and for private repos; optional for public repos.
# GITHUB_TOKEN=""

# --- Django ---
# DEBUG defaults to False. Local development: set True (then DJANGO_SECRET_KEY may be left empty).
DEBUG="True"
# Required when DEBUG is False, or the server refuses to start. (secret)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=""
# Comma-separated (was ALLOWED_HOSTS). Default localhost,127.0.0.1. Prod: your domain, e.g. "flowsync.example.com".
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
# Comma-separated. Default http://localhost:3000,http://127.0.0.1:3000. In prod the SPA is same-origin (nginx),
# so this only matters for other origins.
# DJANGO_CORS_ALLOWED_ORIGINS=""
# Comma-separated with scheme, needed for /admin login over HTTPS, e.g. "https://flowsync.example.com".
# DJANGO_CSRF_TRUSTED_ORIGINS=""
# True when a TLS proxy (ALB/Caddy) in front sets X-Forwarded-Proto: trust it and mark cookies Secure.
# DJANGO_BEHIND_HTTPS_PROXY="False"
# HSTS max-age seconds (only with DJANGO_BEHIND_HTTPS_PROXY). Start small, e.g. 3600.
# DJANGO_HSTS_SECONDS="0"
# LOG_LEVEL="INFO"

# --- MySQL (docker-compose.yml / docker-compose.prod.yml pass these to the db service) ---
MYSQL_ROOT_PASSWORD=""
DB_NAME="flowsync"
DB_USER="flowsync"
DB_PASSWORD=""
DB_HOST="127.0.0.1"
DB_PORT="3306"

# --- docker-compose.prod.yml only ---
# ENV_FILE=".env"
# GUNICORN_WORKERS="3"
# HTTP_PORT="80"
